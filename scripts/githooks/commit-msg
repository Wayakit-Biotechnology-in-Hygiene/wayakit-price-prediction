#!/usr/bin/env bash
# git commit-msg hook: every commit says how it was verified and, if it says verify.sh ran, that is true.
# Installed with scripts/install_githooks.sh (git config core.hooksPath scripts/githooks).
#
# Rule (REVIEW.md, rule 10): the final message carries ONE trailer, in the last paragraph and separated
# from the body by a blank line, that matches exactly
#   ^Verified: (quick|full|none) \(.+\)$
# Examples:
#   Verified: full (verify.sh full — quick: OK (...); e2e-differential: OK (...))
#   Verified: quick (e2e and differential did not run: data/f1_before_2026-11-15/ is missing)
#   Verified: none (docs only)
#
# What is checked:
#   - The trailer is read with "git interpret-trailers --parse" on the message without comments: a
#     "Verified:" in the subject or in the middle of the body does not count. More than one is rejected.
#   - quick / full: there must be a scripts/verify.sh record in .claude/state/verifications.jsonl
#     (or .claude/state/last_verification.json) with result OK, the same tree as this commit
#     ("git write-tree" of the index about to be committed) and index_matches_tree=true.
#       full:  the last "full" record for that tree is OK.
#       quick: the last "quick" record for that tree is OK, or the last "full" one is.
#     That is why verify.sh runs AFTER "git add". With "git commit -a" or "git commit <file>"
#     the index changes on commit and the record does not match: run "git add", run verify and commit.
#   - none: always accepted (there is no record to compare) and logged.
#   - During rebase, cherry-pick or revert the commits already carry their stamp: only the format is checked.
#
# Log: .claude/state/commit_msg.log (date, mode, decision and short tree; never the message text).
# Skipping this hook (git commit --no-verify) is forbidden in this repo; the PreToolUse hook
# scripts/hooks/commit_stamp.sh blocks it in Claude Code sessions.
#
# Manual test (in a temporary clone, never in the real repo):
#   printf 'x\n\nVerified: none (test)\n' > /tmp/m; scripts/githooks/commit-msg /tmp/m; echo $?

set -u

MSG_FILE="${1:?usage: commit-msg <message-file>}"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
STATE="$ROOT/.claude/state"
mkdir -p "$STATE" 2>/dev/null || true
LOG="$STATE/commit_msg.log"
REGEX='^Verified: (quick|full|none) \(.+\)$'

note() { printf '%s mode=%s decision=%s tree=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" "${3:0:12}" >> "$LOG" 2>/dev/null || true; }

reject() {
  {
    echo "Commit rejected (scripts/githooks/commit-msg): $1"
    shift
    for l in "$@"; do echo "  $l"; done
    echo "Format: one trailer line at the end, separated from the body by a blank line:"
    echo "  Verified: <quick|full|none> (<detail or reason>)"
    echo "If it was not verified, write \"Verified: none (reason)\"; do not invent a verification."
  } >&2
  exit 1
}

CLEAN="$(git stripspace --strip-comments < "$MSG_FILE")"
TRAILERS="$(printf '%s\n' "$CLEAN" | git interpret-trailers --parse 2>/dev/null || true)"
STAMPS="$(printf '%s\n' "$TRAILERS" | grep -i '^verified:' || true)"
N_STAMPS="$(printf '%s' "$STAMPS" | grep -c . || true)"

if [ "${N_STAMPS:-0}" -eq 0 ]; then
  if printf '%s\n' "$CLEAN" | grep -qi 'verified:'; then
    note "?" "rejected_outside_trailer" ""
    reject "there is a \"Verified:\" but it is not a trailer." \
      "It must go in the last paragraph of the message, on its own line, separated from the body by a blank line." \
      "If there is a Co-Authored-By, it goes in that same paragraph, right above (no blank line between the two)."
  fi
  note "?" "rejected_no_stamp" ""
  reject "the message has no \"Verified:\" line."
fi
if [ "$N_STAMPS" -gt 1 ]; then
  note "?" "rejected_multiple_stamps" ""
  reject "there are $N_STAMPS \"Verified:\" trailers; there must be exactly one."
fi
if ! printf '%s\n' "$STAMPS" | grep -Eq "$REGEX"; then
  note "?" "rejected_format" ""
  reject "the stamp does not match the format." "Received: $STAMPS"
fi

MODE="$(printf '%s\n' "$STAMPS" | sed -E 's/^Verified: ([a-z0-9]+) .*/\1/')"

case "$MODE" in
  none)
    note "$MODE" "accepted_without_record" ""
    exit 0 ;;
esac

# quick / full: a verify.sh record for this same index is required.
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] || \
   [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] || [ -f "$GIT_DIR/REVERT_HEAD" ]; then
  note "$MODE" "accepted_sequencer_format_only" ""
  exit 0
fi

TREE="$(git write-tree 2>/dev/null || true)"   # honors GIT_INDEX_FILE: it is the tree of THIS commit
[ -n "$TREE" ] || reject "could not compute the index tree (unresolved conflicts?)."

PY="$(command -v python3 || true)"
[ -n "$PY" ] || { [ -x /usr/bin/python3 ] && PY=/usr/bin/python3; }
if [ -z "$PY" ]; then
  note "$MODE" "rejected_no_python" "$TREE"
  reject "there is no python3 to read the verify.sh record; the \"$MODE\" stamp cannot be checked."
fi

VERDICT="$("$PY" - "$MODE" "$TREE" "$STATE/verifications.jsonl" "$STATE/last_verification.json" <<'PYEOF'
import json, sys
mode, tree, history, last = sys.argv[1:5]
recs = []
try:
    with open(history, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    recs.append(json.loads(line))
                except ValueError:
                    pass
except OSError:
    pass
if not recs:
    try:
        with open(last, encoding="utf-8") as f:
            recs.append(json.load(f))
    except (OSError, ValueError):
        pass
for_tree = [r for r in recs if isinstance(r, dict) and r.get("tree") == tree]

def latest(m):
    c = [r for r in for_tree if r.get("mode") == m]
    return c[-1] if c else None

def valid(r):
    return r is not None and r.get("result") == "OK" and r.get("index_matches_tree") is True

if mode == "full":
    cand = [latest("full")]
else:
    cand = [latest("quick"), latest("full")]
for r in cand:
    if valid(r):
        print("OK " + str(r.get("date", "")))
        sys.exit(0)
if not for_tree:
    print("NO_RECORD")
elif any(r is not None and r.get("result") == "OK" and r.get("index_matches_tree") is not True for r in cand):
    print("INDEX_MISMATCH")
elif all(r is None for r in cand):
    print("NO_RECORD_FOR_MODE")
else:
    print("FAIL")
PYEOF
)"

case "$VERDICT" in
  OK*)
    note "$MODE" "accepted_record_${VERDICT#OK }" "$TREE"
    exit 0 ;;
  NO_RECORD)
    note "$MODE" "rejected_no_record" "$TREE"
    reject "the stamp says \"$MODE\" but there is no verify.sh run for this index (tree ${TREE:0:12})." \
      "\"git add\" everything that goes in the commit, run \"scripts/verify.sh $MODE\" and commit again." \
      "With \"git commit -a\" or \"git commit <file>\" the index changes on commit: use git add first." ;;
  NO_RECORD_FOR_MODE)
    note "$MODE" "rejected_no_record_for_mode" "$TREE"
    reject "there are verify.sh runs for this index, but none in \"$MODE\" mode." \
      "Run \"scripts/verify.sh $MODE\" or use the stamp of the mode that did run." ;;
  INDEX_MISMATCH)
    note "$MODE" "rejected_index_mismatch" "$TREE"
    reject "verify.sh passed, but when it ran there were changes without \"git add\" or untracked files." \
      "What was tested is not exactly what is being committed. Add (or stash) those changes and run verify again." ;;
  *)
    note "$MODE" "rejected_verification_failed" "$TREE"
    reject "the last run of \"scripts/verify.sh $MODE\" for this index ended in FAIL." \
      "Fix the cause and run it again; or, if it was not verified, use \"Verified: none (reason)\"." ;;
esac
