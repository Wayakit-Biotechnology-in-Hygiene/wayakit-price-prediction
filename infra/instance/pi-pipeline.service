# Price Intelligence monthly pipeline (F3). Installed and enabled by infra/instance/bootstrap.sh
# as /etc/systemd/system/pi-pipeline.service; it replaces the ec2-user crontab lines.
#
# Runs on every boot, but ExecCondition (pi_boot_guard.py) only lets it through on the scheduled
# boot (last Thursday of the month, 21:40-23:00 America/Mexico_City). Any other boot (maintenance
# over SSM, a manual start) skips ExecStart without marking the unit failed, and the instance
# stays on. A guard error (exit 255) marks the unit failed and the pipeline does not run.
# run_pipeline.sh shuts the instance down when it ends (its EXIT trap) and sends the SNS failure
# alert when PI_ALERTS_TOPIC_ARN is set; stopping the unit or the instance mid-run also counts as
# a failure (exit 143) and sends it.
#
# Type=exec, not oneshot: the unit is "active (running)" as soon as run_pipeline.sh starts, so the
# boot (multi-user.target) finishes instead of staying "starting" for a run of up to 30 h or more.
# ExecCondition still runs first and still decides whether ExecStart runs.
#
# The code path is fixed: /home/ec2-user/wayakit-price-prediction, since F4 a symlink to the
# active release (/home/ec2-user/pi-releases/<sha>) that pi-deploy.service sets before this unit
# starts (After= only: a failed install never blocks the run, which then uses the release that
# was already active). pi_deploy.py refuses to move the link while this unit is active. The env
# file holds no secrets: PI_LOG_DIR, PI_ALERTS_TOPIC_ARN, PI_RELEVANCE_PRIMARY_MODEL and
# PI_RELEVANCE_FALLBACK_MODEL (written by bootstrap.sh).
#
# Check:  systemctl status pi-pipeline.service; journalctl -u pi-pipeline.service -b

[Unit]
Description=Price Intelligence monthly pipeline (only on the scheduled boot)
Wants=network-online.target
After=network-online.target pi-deploy.service

[Service]
Type=exec
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/wayakit-price-prediction
EnvironmentFile=/etc/price-intelligence.env
ExecCondition=/usr/bin/python3 /home/ec2-user/wayakit-price-prediction/infra/instance/pi_boot_guard.py
# One run, no arguments (no stages since 2026-11-18): run_pipeline.sh exits 1 on any argument.
ExecStart=/bin/bash /home/ec2-user/wayakit-price-prediction/run_pipeline.sh
# With Type=exec the start timeout only covers the boot guard and the exec; kept infinite so a
# slow boot never kills the run. The run itself has no time limit (scraping has its own 30 h).
TimeoutStartSec=infinity
# Stopping the unit by hand (systemctl stop) kills the whole run, Chrome included.
KillMode=control-group

[Install]
WantedBy=multi-user.target
